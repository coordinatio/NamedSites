{
  "manifest_version": 3,
  "name": "NamedSites",
  "version": "0.1.0",
  "description": "Prefixes the browser window title based on rules matching the active tab's URL.",
  "browser_specific_settings": {
    "gecko": {
      "id": "named-sites@contentai.ru",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["tabs", "storage"],
  "background": {
    "scripts": ["matcher.js", "background.js"]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}